# Base URL used for metadata, canonical links and checkout return URLs (https://iloveui.dev in production builds)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Accounts, pricing, checkout and Pro designs: false (the default) serves every design free with no accounts; true turns the paid architecture back on
MONETIZATION_ENABLED=false
# Pricing region when the CF-IPCountry header is absent (local development): IN shows INR, any other code shows USD
DEV_REGION=IN
# Pepper mixed into SHA-256 hashes of CLI tokens; generated by pnpm setup (required)
TOKEN_PEPPER=
# Signing secret for local test checkout webhooks; generated by pnpm setup (required)
LOCAL_WEBHOOK_SECRET=
# Clerk publishable key; pnpm setup provisions a temporary accountless Clerk development app when empty
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key; provisioned together with the publishable key, replace both to use your own Clerk app
CLERK_SECRET_KEY=
# Signing secret (whsec_...) of the Clerk webhook endpoint; only needed in production
CLERK_WEBHOOK_SIGNING_SECRET=
# Dodo Payments API key; setting it switches checkout from the local test checkout to Dodo Payments
DODO_PAYMENTS_API_KEY=
# Dodo Payments webhook signing key (whsec_...) from the Dodo dashboard
DODO_PAYMENTS_WEBHOOK_KEY=
# Dodo Payments environment: test_mode or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Dodo product id for the Pro lifetime license in USD
DODO_PRODUCT_PRO_USD=
# Dodo product id for the Pro lifetime license in INR
DODO_PRODUCT_PRO_INR=
# Dodo product id for the Team lifetime license in USD
DODO_PRODUCT_TEAM_USD=
# Dodo product id for the Team lifetime license in INR
DODO_PRODUCT_TEAM_INR=
# Cloudflare account id for deploys; export it in your shell or CI instead of filling it here
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API token for deploys; export it in your shell or CI instead of filling it here
CLOUDFLARE_API_TOKEN=
