{
  "name": "iloveui",
  "version": "0.1.0",
  "private": true,
  "description": "A marketplace of production-ready UI designs for React and HTML, re-themeable to your brand.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node --disable-warning=DEP0040 --import tsx scripts/setup.ts",
    "dev": "pnpm build-registry && next dev --port 3000",
    "build": "pnpm cf-typegen && pnpm build-registry && next build",
    "preview": "opennextjs-cloudflare build && tsx scripts/check-build.ts && opennextjs-cloudflare preview --port 3000",
    "typecheck": "pnpm cf-typegen && pnpm build-registry --no-r2 && next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier . --check && tsx scripts/check-forbidden.ts",
    "format": "prettier . --write",
    "test": "pnpm build-registry --no-r2 && vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "validate-registry": "node --disable-warning=DEP0040 --import tsx scripts/validate-registry.ts",
    "build-registry": "node --disable-warning=DEP0040 --import tsx scripts/build-registry.ts",
    "build-zips": "node --disable-warning=DEP0040 --import tsx scripts/build-zips.ts",
    "design:check": "node --disable-warning=DEP0040 --import tsx scripts/design-check.ts",
    "db:generate": "drizzle-kit generate",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts > /dev/null",
    "gates": "tsx scripts/gates.ts",
    "lighthouse": "tsx scripts/lighthouse.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.20",
    "@clerk/ui": "1.41.2",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.3",
    "@opennextjs/cloudflare": "1.20.13",
    "clsx": "2.1.1",
    "dodopayments": "2.57.0",
    "drizzle-orm": "0.45.4",
    "fuse.js": "7.5.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@clerk/testing": "2.2.50",
    "@playwright/test": "1.64.1",
    "@shikijs/langs": "4.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.22.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
